<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format Landscape -->
    <record id="paperformat_tursys_landscape" model="report.paperformat">
        <field name="name">TurSys Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_tursys_passenger_list" model="ir.actions.report">
        <field name="name">Passenger List</field>
        <field name="model">tursys.excursion</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tursys.report_passenger_list_template</field>
        <field name="report_file">tursys.report_passenger_list_template</field>
        <field name="print_report_name">'Passenger List - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_tursys_excursion"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_tursys_landscape"/>
    </record>

    <!-- Report Template -->
    <template id="report_passenger_list_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2 style="color: #2c3e50; border-bottom: 2px solid #2c3e50; display: inline-block; padding-bottom: 5px;">
                                Passenger List
                            </h2>
                            <h4 class="text-muted"><t t-esc="o.name"/></h4>
                        </div>

                        <div class="row mt-3 mb-4" style="background-color: #f8f9fa; padding: 15px; border-radius: 5px; border: 1px solid #dee2e6;">
                            <div class="col-3">
                                <strong>Date &amp; Start Time:</strong>
                                <p class="m-0" style="font-size: 1.1em; font-weight: bold; color: #e67e22;">
                                    <span t-field="o.start_datetime" t-options='{"widget": "datetime", "hide_seconds": True}'/>
                                </p>
                            </div>
                            <div class="col-3">
                                <strong>End Time:</strong>
                                <p class="m-0" t-field="o.end_datetime" t-options='{"widget": "datetime", "hide_seconds": True}'/>
                            </div>
                            <div class="col-3">
                                <strong>Service:</strong>
                                <p class="m-0" t-field="o.product_id.name"/>
                            </div>
                            <div class="col-3 text-right">
                                <strong>Status:</strong>
                                <p class="m-0" t-field="o.state"/>
                            </div>
                        </div>

                        <table class="table table-sm table-striped o_main_table">
                            <thead style="background-color: #34495e; color: white;">
                                <tr>
                                    <th name="th_name" class="text-left" style="width: 25%;">Passenger Name</th>
                                    <th name="th_vat" class="text-left" style="width: 15%;">VAT/Passport</th>
                                    <th name="th_nationality" class="text-left" style="width: 15%;">Nationality</th>
                                    <th name="th_birthdate" class="text-left" style="width: 15%;">Birthdate</th>
                                    <th name="th_special" class="text-left" style="width: 30%;">Special Needs / Obs.</th>
                                </tr>
                            </thead>
                            <tbody class="invoice_tbody">
                                <t t-foreach="o.booking_ids.filtered(lambda a: a.state == 'confirmed')" t-as="booking">
                                    <t t-foreach="booking.pax_ids" t-as="line">
                                        <tr>
                                            <td><span t-field="line.partner_id.name"/></td>
                                            <td><span t-field="line.partner_id.vat"/></td>
                                            <td><span t-field="line.partner_id.country_id.name"/></td>
                                            <td><span t-field="line.partner_id.birthdate"/></td>
                                            <td>
                                                <div t-field="line.partner_id.special_needs"/>
                                                <div class="small text-muted" t-field="line.observations"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <div class="row mt-4 pt-3" style="border-top: 2px solid #34495e;">
                            <div class="col-6">
                                <strong>Notes:</strong>
                                <p class="small text-muted">This list only includes confirmed bookings.</p>
                            </div>
                            <div class="col-6 text-right">
                                <h4 style="color: #2c3e50;">
                                    <strong>Total Passengers: </strong> 
                                    <span style="color: #e67e22;"><t t-esc="o.capacity_used"/> / <t t-esc="o.capacity_total"/></span>
                                </h4>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

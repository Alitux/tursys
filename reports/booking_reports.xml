<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action -->
    <record id="action_report_booking_voucher" model="ir.actions.report">
        <field name="name">Booking Voucher</field>
        <field name="model">tursys.booking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tursys.report_booking_voucher_template</field>
        <field name="report_file">tursys.report_booking_voucher_template</field>
        <field name="print_report_name">'Voucher - %s - %s' % (object.pax_name, object.name)</field>
        <field name="binding_model_id" ref="model_tursys_booking"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Report Template -->
    <template id="report_booking_voucher_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica', sans-serif; color: #2c3e50; padding: 0 10px;">
                        <!-- Header Mini -->
                        <div class="row align-items-center" style="border-bottom: 2px solid #1a2a6c; padding-bottom: 10px; margin-bottom: 20px;">
                            <div class="col-8">
                                <h1 style="color: #1a2a6c; font-weight: 900; font-size: 2.5em; margin: 0;">VOUCHER</h1>
                                <p class="m-0 text-muted" style="letter-spacing: 2px; font-size: 0.9em;">CONFIRMED RESERVATION</p>
                            </div>
                            <div class="col-4 text-right">
                                <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" style="max-height: 60px;" alt="Logo"/>
                            </div>
                        </div>

                        <!-- Info Grid Compact -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div style="background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 8px; padding: 20px;">
                                    <div class="row">
                                        <div class="col-6" style="border-right: 1px solid #dee2e6;">
                                            <h6 style="color: #e67e22; font-weight: bold; text-transform: uppercase; margin-bottom: 15px;">Passenger Info</h6>
                                            <p style="font-size: 1.2em; font-weight: bold; margin-bottom: 5px;"><t t-esc="o.pax_name"/></p>
                                            <p class="m-0 small"><strong>ID / Passport:</strong> <t t-esc="o.pax_vat"/></p>
                                            <p class="m-0 small"><strong>Nationality:</strong> <t t-esc="o.pax_nationality_id.name"/></p>
                                            <p class="m-0 small"><strong>Age:</strong> <t t-esc="o.pax_age"/> years</p>
                                            <p class="m-0 small"><strong>Email:</strong> <t t-esc="o.pax_email"/></p>
                                        </div>
                                        <div class="col-6 pl-4">
                                            <h6 style="color: #e67e22; font-weight: bold; text-transform: uppercase; margin-bottom: 15px;">Excursion Details</h6>
                                            <p style="font-size: 1.2em; font-weight: bold; margin-bottom: 5px;"><t t-esc="o.excursion_id.product_id.name"/></p>
                                            <p class="m-0 small"><strong>Booking Ref:</strong> <t t-esc="o.name"/></p>
                                            <p class="m-0 small"><strong>Date:</strong> <span t-field="o.excursion_id.start_datetime" t-options='{"format": "dd/MM/yyyy"}'/></p>
                                            <p class="m-0 small"><strong>Time:</strong> <span t-field="o.excursion_id.start_datetime" t-options='{"format": "HH:mm"}'/> hrs</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Instructions -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div style="border-left: 3px solid #1a2a6c; padding-left: 15px;">
                                    <strong style="font-size: 0.9em;">IMPORTANT INSTRUCTIONS:</strong>
                                    <ul style="font-size: 0.85em; color: #555; margin-top: 5px;">
                                        <li>Please arrive 15 minutes before the departure time.</li>
                                        <li>Bring a valid ID to verify your identity.</li>
                                        <li>Keep this voucher on your phone or printed.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Footer / Validation -->
                        <div class="row align-items-end mt-4 pt-3" style="border-top: 1px solid #eee;">
                            <div class="col-8">
                                <p style="font-size: 0.75em; color: #7f8c8d; line-height: 1.2;">
                                    <strong><t t-esc="res_company.name"/></strong><br/>
                                    <t t-esc="res_company.phone"/> | <t t-esc="res_company.email"/><br/>
                                    <t t-esc="res_company.street"/> <t t-esc="res_company.city"/>
                                </p>
                            </div>
                            <div class="col-4 text-right">
                                <p class="text-muted" style="font-size: 0.7em; margin-bottom: 2px;">Verification ID:</p>
                                <code style="font-size: 0.75em; color: #95a5a6;"><t t-esc="o.qr_uuid"/></code>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_booking_voucher" model="mail.template">
            <field name="name">Booking: Send Voucher</field>
            <field name="model_id" ref="tursys.model_tursys_booking"/>
            <field name="subject">Your Booking Voucher - {{ object.name }}</field>
            <field name="email_from">{{ (object.env.user.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.passenger_id.id }}</field>
            <field name="description">Template to send booking voucher to passengers</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello <t t-out="object.pax_name"/>,<br/><br/>
                        Thank you for booking with <strong><t t-out="res_company.name"/></strong>.
                        Please find your voucher for the excursion <strong><t t-out="object.excursion_id.product_id.name"/></strong> attached to this email.
                        <br/><br/>
                        <strong>Details:</strong><br/>
                        - Date: <t t-out="object.excursion_id.start_datetime.strftime('%d/%m/%Y')"/><br/>
                        - Time: <t t-out="object.excursion_id.start_datetime.strftime('%H:%M')"/> hs<br/>
                        <br/>
                        We look forward to seeing you!
                        <br/><br/>
                        Best regards.
                    </p>
                </div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('tursys.action_report_booking_voucher'))]"/>
            <field name="lang">{{ object.passenger_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>

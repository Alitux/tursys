<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tarjeta en el home del portal (sólo visible para guías) -->
    <template id="portal_my_home_excursion" name="Portal My Home: TurSys Excursiones"
              inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="request.env.user.is_tursys_guide">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/tursys/static/description/icon.png'"/>
                    <t t-set="title">Excursions</t>
                    <t t-set="text">Excursions assigned to you</t>
                    <t t-set="url" t-value="'/my/excursions'"/>
                    <t t-set="placeholder_count" t-value="'excursion_count'"/>
                </t>
            </t>
        </xpath>
    </template>

    <!-- Listado de excursiones asignadas -->
    <template id="portal_my_excursions" name="TurSys: Mis excursiones">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Excursions</t>
            </t>
            <t t-if="not excursions">
                <div class="alert alert-info" role="alert">
                    You have no excursions assigned yet.
                </div>
            </t>
            <t t-if="excursions">
                <!-- Escritorio: tabla -->
                <div class="table-responsive d-none d-md-block">
                    <t t-call="portal.portal_table">
                        <thead>
                            <tr>
                                <th>Excursion</th>
                                <th>Date</th>
                                <th class="text-end">Passengers</th>
                                <th class="text-end">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="excursions" t-as="excursion">
                                <td>
                                    <a t-attf-href="/my/excursions/#{excursion.id}">
                                        <span t-field="excursion.name"/>
                                    </a>
                                </td>
                                <td>
                                    <span t-field="excursion.start_datetime" t-options='{"widget": "date"}'/>
                                </td>
                                <td class="text-end">
                                    <span t-out="excursion.capacity_used"/> / <span t-out="excursion.capacity_total"/>
                                </td>
                                <td class="text-end">
                                    <span t-out="state_labels.get(excursion.state)"/>
                                </td>
                            </tr>
                        </tbody>
                    </t>
                </div>

                <!-- Móvil: tarjetas -->
                <div class="d-md-none">
                    <a t-foreach="excursions" t-as="excursion" class="text-decoration-none text-reset"
                       t-attf-href="/my/excursions/#{excursion.id}">
                        <div class="card mb-3 shadow-sm o_tursys_excursion_card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="fw-bold fs-5"><span t-field="excursion.name"/></div>
                                    <span class="badge text-bg-secondary flex-shrink-0"
                                          t-out="state_labels.get(excursion.state)"/>
                                </div>
                                <div class="text-muted small mt-2">
                                    <i class="fa fa-calendar me-1"/>
                                    <span t-field="excursion.start_datetime" t-options='{"widget": "datetime"}'/>
                                </div>
                                <div class="text-muted small mt-1">
                                    <i class="fa fa-users me-1" title="Pax"/>
                                    <span t-out="excursion.capacity_used"/> / <span t-out="excursion.capacity_total"/> pax
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </t>
            <div t-if="pager" class="o_portal_pager">
                <t t-call="portal.pager"/>
            </div>
        </t>
    </template>

    <!-- Detalle de la excursión con lista de pasajeros y check-in -->
    <template id="portal_excursion_page" name="TurSys: Detalle de la excursión">
        <t t-call="portal.portal_layout">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/my/home">Home</a></li>
                <li class="breadcrumb-item"><a href="/my/excursions">Excursions</a></li>
                <li class="breadcrumb-item active text-truncate" t-out="excursion.name"/>
            </ol>

            <div class="row mb-3 g-2 align-items-center">
                <div class="col-lg-8">
                    <h3 class="mb-1" t-field="excursion.name"/>
                    <div class="text-muted">
                        <i class="fa fa-calendar me-1"/>
                        <span t-field="excursion.start_datetime"/>
                        <span class="mx-1">→</span>
                        <span t-field="excursion.end_datetime"/>
                    </div>
                    <div class="small text-muted mt-1"
                         t-if="excursion.actual_start_datetime or excursion.actual_end_datetime">
                        <i class="fa fa-clock-o me-1"/>
                        <t t-if="excursion.actual_start_datetime">
                            Started <span t-field="excursion.actual_start_datetime" t-options='{"widget": "datetime"}'/>
                        </t>
                        <t t-if="excursion.actual_end_datetime">
                            · Finished <span t-field="excursion.actual_end_datetime" t-options='{"widget": "datetime"}'/>
                        </t>
                    </div>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <div class="mb-2">
                        <span t-if="excursion.state == 'in_progress'" class="badge text-bg-warning"
                              t-out="state_labels.get(excursion.state)"/>
                        <span t-elif="excursion.state == 'done'" class="badge text-bg-success"
                              t-out="state_labels.get(excursion.state)"/>
                        <span t-elif="excursion.state == 'cancelled'" class="badge text-bg-danger"
                              t-out="state_labels.get(excursion.state)"/>
                        <span t-else="" class="badge text-bg-secondary"
                              t-out="state_labels.get(excursion.state)"/>
                    </div>
                    <span class="badge text-bg-info">
                        <t t-out="excursion.capacity_used"/> / <t t-out="excursion.capacity_total"/> pax
                    </span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-2"
                 t-if="is_main_guide and excursion.state in ('scheduled', 'in_progress')">
                <form t-if="excursion.state == 'scheduled'" method="post"
                      t-attf-action="/my/excursions/#{excursion.id}/start">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button type="submit" class="btn btn-warning">
                        <i class="fa fa-play me-1"/>Start Excursion
                    </button>
                </form>
                <form t-if="excursion.state == 'in_progress'" method="post"
                      t-attf-action="/my/excursions/#{excursion.id}/finish">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button type="submit" class="btn btn-success">
                        <i class="fa fa-flag-checkered me-1"/>Finish Excursion
                    </button>
                </form>
            </div>

            <div class="o_tursys_pax_search">
                <div class="d-flex justify-content-between align-items-center mt-4 mb-2 gap-2 flex-wrap">
                    <h4 class="mb-0">
                        Passengers (<t t-out="len(bookings)"/>)
                    </h4>
                    <div class="position-relative" t-if="bookings">
                        <input type="search" class="form-control form-control-sm o_tursys_pax_input pe-5"
                               placeholder="Search name, ID, phone, email..." autocomplete="off"
                               style="min-width: 240px;"/>
                        <i class="fa fa-search position-absolute top-50 end-0 translate-middle-y me-3 text-muted"/>
                    </div>
                </div>
                <div class="small text-muted mb-2 o_tursys_pax_counter"/>

                <t t-if="bookings">
                    <!-- Escritorio: tabla -->
                    <div class="table-responsive d-none d-md-block">
                        <table class="table table-hover align-middle o_portal_my_doc_table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>ID / VAT</th>
                                    <th>Age</th>
                                    <th>Nationality</th>
                                    <th>Phone</th>
                                    <th>Needs</th>
                                    <th class="text-end">Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="bookings" t-as="b" t-attf-id="booking-#{b.id}"
                                    class="o_tursys_pax_item"
                                    t-att-data-pax-search="'%s %s %s %s %s' % (b.pax_name or '', b.pax_vat or '', b.pax_phone or '', b.pax_email or '', b.pickup_display or '')">
                                    <td><span t-field="b.pax_name"/>
                                        <span t-if="b.pax_count > 1" class="badge text-bg-light ms-1" t-out="'%s pax' % b.pax_count"/>
                                        <div t-if="b.pax_breakdown" class="text-muted small" t-out="b.pax_breakdown"/>
                                        <div t-if="b.pickup_display" class="text-muted small"><i class="fa fa-map-marker me-1" title="Pickup"/> <span t-field="b.pickup_display"/></div>
                                    </td>
                                    <td><span t-field="b.pax_vat"/></td>
                                    <td><span t-out="b.pax_age"/></td>
                                    <td><span t-field="b.pax_nationality_id"/></td>
                                    <td><span t-field="b.pax_phone"/></td>
                                    <td><span t-field="b.pax_special_needs"/></td>
                                    <td class="text-end">
                                        <span t-if="b.state == 'attended'" t-attf-class="badge #{'text-bg-warning' if b.attended_pax &lt; b.pax_count else 'text-bg-success'}">
                                            <t t-out="b.attended_pax"/>/<t t-out="b.pax_count"/>
                                        </span>
                                        <span t-elif="b.state == 'no_show'" class="badge text-bg-danger">No Show</span>
                                        <span t-else="" class="badge text-bg-secondary">Confirmed</span>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <form t-if="b.state == 'confirmed'" class="d-inline-flex align-items-center gap-1"
                                              t-attf-action="/my/excursions/#{excursion.id}/booking/#{b.id}/check_in" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="number" name="attended_pax" class="form-control form-control-sm text-center"
                                                   style="width: 60px;" min="0" t-att-max="b.pax_count" t-att-value="b.pax_count"
                                                   title="People present"/>
                                            <button type="submit" class="btn btn-sm btn-success">Check-in</button>
                                        </form>
                                        <form t-if="b.state == 'confirmed'" class="d-inline"
                                              t-attf-action="/my/excursions/#{excursion.id}/booking/#{b.id}/no_show" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-sm btn-outline-danger">No Show</button>
                                        </form>
                                        <form t-if="b.state in ('attended', 'no_show')" class="d-inline"
                                              t-attf-action="/my/excursions/#{excursion.id}/booking/#{b.id}/undo" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Undo</button>
                                        </form>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- Móvil: tarjetas con botones grandes -->
                    <div class="d-md-none">
                        <div class="card mb-2 o_tursys_pax_item" t-foreach="bookings" t-as="b" t-attf-id="booking-#{b.id}"
                             t-att-data-pax-search="'%s %s %s %s %s' % (b.pax_name or '', b.pax_vat or '', b.pax_phone or '', b.pax_email or '', b.pickup_display or '')">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="fw-bold fs-5" t-field="b.pax_name"/>
                                    <div class="text-end">
                                        <span t-if="b.state == 'attended'" t-attf-class="badge #{'text-bg-warning' if b.attended_pax &lt; b.pax_count else 'text-bg-success'}">
                                            <t t-out="b.attended_pax"/>/<t t-out="b.pax_count"/>
                                        </span>
                                        <span t-elif="b.state == 'no_show'" class="badge text-bg-danger">No Show</span>
                                        <span t-else="" class="badge text-bg-secondary">Confirmed</span>
                                    </div>
                                </div>
                                <div class="small text-muted mt-2">
                                    <div t-if="b.pax_count > 1 or b.pax_breakdown" class="mb-1">
                                        <i class="fa fa-users me-1" title="Pax"/><t t-out="b.pax_count"/> pax
                                        <t t-if="b.pax_breakdown"> · <t t-out="b.pax_breakdown"/></t>
                                    </div>
                                    <div class="mb-1">
                                        <i class="fa fa-id-card me-1"/><span t-field="b.pax_vat"/>
                                        <t t-if="b.pax_age"> · <t t-out="b.pax_age"/> years</t>
                                    </div>
                                    <div t-if="b.pax_phone" class="mb-1">
                                        <i class="fa fa-phone me-1"/><a t-attf-href="tel:#{b.pax_phone}" t-field="b.pax_phone"/>
                                    </div>
                                    <div t-if="b.pax_nationality_id" class="mb-1">
                                        <i class="fa fa-globe me-1"/><span t-field="b.pax_nationality_id"/>
                                    </div>
                                    <div t-if="b.pickup_display" class="mb-1">
                                        <i class="fa fa-map-marker me-1"/><span t-field="b.pickup_display"/>
                                    </div>
                                    <div t-if="b.pax_special_needs" class="mb-1 text-danger">
                                        <i class="fa fa-medkit me-1"/><span t-field="b.pax_special_needs"/>
                                    </div>
                                    <div t-if="b.observations">
                                        <i class="fa fa-comment-o me-1"/><span t-field="b.observations"/>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-3">
                                    <form t-if="b.state == 'confirmed'" class="flex-fill"
                                          t-attf-action="/my/excursions/#{excursion.id}/booking/#{b.id}/check_in" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="input-group input-group-sm mb-1">
                                            <div class="input-group-text">Present</div>
                                            <input type="number" name="attended_pax" class="form-control text-center"
                                                   min="0" t-att-max="b.pax_count" t-att-value="b.pax_count"/>
                                        </div>
                                        <button type="submit" class="btn btn-success w-100">
                                            <i class="fa fa-check me-1"/>Check-in
                                        </button>
                                    </form>
                                    <form t-if="b.state == 'confirmed'" class="flex-fill"
                                          t-attf-action="/my/excursions/#{excursion.id}/booking/#{b.id}/no_show" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-outline-danger w-100">No Show</button>
                                    </form>
                                    <form t-if="b.state in ('attended', 'no_show')" class="flex-fill"
                                          t-attf-action="/my/excursions/#{excursion.id}/booking/#{b.id}/undo" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-outline-secondary w-100">Undo</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="alert alert-info" role="alert">
                        There are no passengers to show for this excursion yet.
                    </div>
                </t>
                <div class="alert alert-warning d-none o_tursys_pax_no_result" role="alert">
                    No passengers match your search.
                </div>
            </div>

            <!-- Notas del guía (se publican en el chatter de la excursión) -->
            <h4 class="mt-4 mb-2">Guide notes</h4>
            <div t-if="comments" class="mb-3">
                <div t-foreach="comments" t-as="msg" class="border-start border-3 ps-3 mb-3">
                    <div class="small text-muted">
                        <i class="fa fa-user-circle me-1"/><span t-field="msg.author_id.name"/>
                        <span class="mx-1">·</span>
                        <span t-field="msg.date" t-options='{"widget": "datetime"}'/>
                    </div>
                    <div t-field="msg.body"/>
                </div>
            </div>
            <div t-else="" class="text-muted small mb-3">No notes yet.</div>

            <form method="post" t-attf-action="/my/excursions/#{excursion.id}/comment" class="mt-2">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="mb-2">
                    <textarea name="comment" class="form-control" rows="3"
                              placeholder="Add a note about this excursion (weather, incidents, something particular...)"></textarea>
                </div>
                <button type="submit" class="btn btn-secondary">
                    <i class="fa fa-comment me-1"/>Save note
                </button>
            </form>
        </t>
    </template>
</odoo>

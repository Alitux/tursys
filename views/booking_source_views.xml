<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tursys_booking_source_list" model="ir.ui.view">
        <field name="name">tursys.booking.source.list</field>
        <field name="model">tursys.booking.source</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" placeholder="Web / GYG / Viator / Other agency..."/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_tursys_booking_source_form" model="ir.ui.view">
        <field name="name">tursys.booking.source.form</field>
        <field name="model">tursys.booking.source</field>
        <field name="arch" type="xml">
            <form string="Booking Source">
                <sheet>
                    <group>
                        <field name="name" placeholder="Web / GYG / Viator / Other agency..."/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tursys_booking_source" model="ir.actions.act_window">
        <field name="name">Booking Sources</field>
        <field name="res_model">tursys.booking.source</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

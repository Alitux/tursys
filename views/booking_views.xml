<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tursys_booking_search" model="ir.ui.view">
        <field name="name">tursys.booking.search</field>
        <field name="model">tursys.booking</field>
        <field name="arch" type="xml">
            <search string="Search Passengers">
                <field name="pax_name"/>
                <field name="pax_vat"/>
                <field name="excursion_id"/>
                <field name="passenger_id"/>
                <field name="pickup_free_place"/>
                <field name="source_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="waiting" string="Waiting List" domain="[('state', '=', 'waiting')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="attended" string="Attended" domain="[('state', '=', 'attended')]"/>
                <filter name="no_show" string="No Show" domain="[('state', '=', 'no_show')]"/>
                <separator/>
                <filter name="to_check_in" string="To Check-in" domain="[('state', 'in', ['confirmed', 'attended'])]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_excursion" string="Excursion" context="{'group_by': 'excursion_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_source" string="Booking Source" context="{'group_by': 'source_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_tursys_booking_list" model="ir.ui.view">
        <field name="name">tursys.booking.list</field>
        <field name="model">tursys.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings" decoration-muted="state == 'cancelled'" decoration-success="state == 'attended'" decoration-warning="state == 'waiting'" decoration-danger="state == 'no_show'">
                <field name="name"/>
                <field name="excursion_id"/>
                <field name="pax_name"/>
                <field name="pax_vat"/>
                <field name="pax_age"/>
                <field name="pax_count" string="Pax" optional="show"/>
                <field name="attended_pax" optional="hide"/>
                <field name="pickup_display" optional="show"/>
                <field name="source_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total" optional="show"/>
                <field name="amount_net" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Net" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'waiting'" decoration-success="state in ('confirmed', 'attended')" decoration-danger="state == 'no_show'"/>
                <field name="checkin_datetime" optional="hide"/>
                <button name="action_check_in" string="Check-in" type="object" icon="fa-check" invisible="state != 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="view_tursys_booking_kanban" model="ir.ui.view">
        <field name="name">tursys.booking.kanban</field>
        <field name="model">tursys.booking</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <field name="state"/>
                <field name="excursion_id"/>
                <field name="pax_vat"/>
                <field name="pax_count"/>
                <field name="pax_breakdown"/>
                <field name="pickup_display"/>
                <field name="source_id"/>
                <field name="checkin_datetime"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title"><field name="pax_name"/></strong>
                            </div>
                            <div class="text-muted"><field name="pax_vat"/></div>
                            <div class="mt-1 text-muted small" t-if="record.pax_count.raw_value">
                                <i class="fa fa-users me-1" title="Pax"/><t t-out="record.pax_count.raw_value"/> pax
                                <t t-if="record.pax_breakdown.raw_value"> · <t t-out="record.pax_breakdown.raw_value"/></t>
                            </div>
                            <div class="text-muted"><field name="excursion_id"/></div>
                            <div class="text-muted" t-if="record.pickup_display.raw_value"><field name="pickup_display"/></div>
                            <div class="text-muted" t-if="record.source_id.raw_value"><field name="source_id"/></div>
                            <div class="mt-2 d-flex gap-1">
                                <button type="object" name="action_check_in" class="btn btn-sm btn-success" t-if="record.state.raw_value == 'confirmed'">Check-in</button>
                                <button type="object" name="action_mark_no_show" class="btn btn-sm btn-outline-danger" t-if="record.state.raw_value == 'confirmed'">No Show</button>
                                <button type="object" name="action_undo_check_in" class="btn btn-sm btn-outline-secondary" t-if="record.state.raw_value == 'attended'">Undo</button>
                                <span t-if="record.state.raw_value == 'attended'" class="text-success ms-2">✓ Check-in</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_tursys_booking_form" model="ir.ui.view">
        <field name="name">tursys.booking.form</field>
        <field name="model">tursys.booking</field>
        <field name="arch" type="xml">
            <form string="Booking Card">
                <header>
                    <button name="action_confirm" string="Confirm Booking" type="object" class="oe_highlight" invisible="state != 'draft' and state != 'waiting'"/>
                    <button name="action_waitlist" string="Waiting List" type="object" invisible="state != 'draft'"/>
                    <button name="action_check_in" string="Check-in" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_mark_no_show" string="No Show" type="object" invisible="state != 'confirmed' and state != 'attended'"/>
                    <button name="action_undo_check_in" string="Undo Check-in" type="object" invisible="state != 'attended'"/>
                    <button name="action_send_voucher_email" string="Send by Email" type="object" icon="fa-envelope" invisible="state != 'confirmed' and state != 'attended'"/>
                    <button name="%(tursys.action_report_booking_voucher)d" string="Print Voucher" type="action" icon="fa-ticket" invisible="state == 'cancelled' or state == 'draft'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting,confirmed,attended,no_show,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Booking Number"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <field name="qr_uuid" invisible="not qr_uuid" class="text-muted small"/>
                    </div>
                    <group>
                        <group string="Service Details" invisible="context.get('hide_excursion')">
                            <field name="excursion_id" domain="[('state', '=', 'scheduled')]"/>
                        </group>
                        <group string="Booking Details">
                            <field name="source_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Passenger Profile">
                            <field name="pax_name" placeholder="Full Name" readonly="state != 'draft' and state != 'waiting'"/>
                            <field name="pax_vat" placeholder="DNI / Passport" readonly="state != 'draft' and state != 'waiting'"/>
                            <field name="pax_birthdate" readonly="state != 'draft' and state != 'waiting'"/>
                            <field name="pax_type" readonly="state != 'draft' and state != 'waiting'"/>
                            <field name="pax_nationality_id" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft' and state != 'waiting'"/>
                            <field name="pax_language_id" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft' and state != 'waiting'"/>
                        </group>
                        <group string="Contact Data">
                            <field name="pax_email" widget="email" placeholder="email@example.com" readonly="state != 'draft' and state != 'waiting'"/>
                            <field name="pax_phone" widget="phone" placeholder="+54..." readonly="state != 'draft' and state != 'waiting'"/>
                            <field name="passenger_id" invisible="not passenger_id" class="oe_read_only"/>
                        </group>
                    </group>
                    <group string="Group Composition">
                        <field name="pax_adults"/>
                        <field name="pax_children"/>
                        <field name="pax_infants"/>
                        <field name="pax_retired"/>
                        <field name="pax_disabled"/>
                        <field name="pax_count" readonly="1"/>
                        <field name="pax_breakdown" readonly="1"/>
                    </group>
                    <group string="Pricing">
                        <group>
                            <field name="price_unit" readonly="1"/>
                            <field name="amount_adults" readonly="1"/>
                            <field name="amount_children" readonly="1"/>
                            <field name="amount_infants" readonly="1"/>
                            <field name="amount_retired" readonly="1"/>
                            <field name="amount_disabled" readonly="1"/>
                        </group>
                        <group>
                            <field name="amount_total" readonly="1"/>
                            <field name="commission_rate" readonly="1"/>
                            <field name="commission_amount" readonly="1"/>
                            <field name="amount_net" readonly="1"/>
                            <field name="currency_id" groups="base.group_multi_currency" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Pickup">
                            <field name="pickup_free_place" placeholder="Hotel / hostel / meeting point..."/>
                        </group>
                        <group string="Special Needs &amp; Notes">
                            <field name="pax_special_needs" placeholder="Medical conditions, diets..." readonly="state != 'draft' and state != 'waiting'"/>
                            <field name="observations" readonly="state != 'draft' and state != 'waiting'"/>
                        </group>
                        <group string="Check-in" invisible="state not in ('attended', 'no_show')">
                            <field name="checkin_datetime"/>
                            <field name="checked_in_by"/>
                            <field name="attended_pax"/>
                            <field name="no_show_pax"/>
                        </group>
                    </group>
                    <group string="Cancellation" invisible="state != 'cancelled'">
                        <field name="cancellation_reason"/>
                        <field name="cancellation_note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_tursys_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">tursys.booking</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_tursys_all_passengers" model="ir.actions.act_window">
        <field name="name">Passengers List</field>
        <field name="res_model">tursys.booking</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_to_check_in': 1}</field>
    </record>

    <record id="action_tursys_checkin" model="ir.actions.act_window">
        <field name="name">Check-in</field>
        <field name="res_model">tursys.booking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_to_check_in': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No passengers to check in</p>
            <p>Confirm a booking and it will show up here so the guide can check it in from a mobile device.</p>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Configuration Views -->
    <record id="view_tursys_nationality_list" model="ir.ui.view">
        <field name="name">tursys.nationality.list</field>
        <field name="model">tursys.nationality</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_tursys_language_list" model="ir.ui.view">
        <field name="name">tursys.language.list</field>
        <field name="model">tursys.language</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <!-- Excursion Views -->
    <record id="view_tursys_excursion_list" model="ir.ui.view">
        <field name="name">tursys.excursion.list</field>
        <field name="model">tursys.excursion</field>
        <field name="arch" type="xml">
            <list string="Excursions">
                <field name="name"/>
                <field name="product_id"/>
                <field name="start_datetime" options="{'hide_seconds': True}"/>
                <field name="capacity_total"/>
                <field name="capacity_used"/>
                <field name="capacity_available"/>
                <field name="state" widget="badge" decoration-info="state == 'scheduled'" decoration-success="state == 'done'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_tursys_excursion_form" model="ir.ui.view">
        <field name="name">tursys.excursion.form</field>
        <field name="model">tursys.excursion</field>
        <field name="arch" type="xml">
            <form string="Excursion">
                <header>
                    <button name="%(tursys.action_report_tursys_passenger_list)d" string="Print Passenger List" type="action" class="btn-secondary" icon="fa-print"/>
                    <button name="action_done" string="Finish" type="object" class="oe_highlight" invisible="state != 'scheduled'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="start_datetime" options="{'hide_seconds': True}"/>
                            <field name="duration" widget="float_time"/>
                            <field name="end_datetime" options="{'hide_seconds': True}"/>
                        </group>
                        <group>
                            <field name="capacity_total"/>
                            <field name="capacity_used"/>
                            <field name="capacity_available"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Confirmed Passengers" name="bookings">
                            <field name="booking_ids" context="{'default_excursion_id': id, 'hide_excursion': True}">
                                <list>
                                    <field name="pax_name"/>
                                    <field name="pax_vat"/>
                                    <field name="pax_age"/>
                                    <field name="pax_nationality_id"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
                                    <button name="action_confirm" string="Confirm" type="object" icon="fa-check" invisible="state != 'draft'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Booking Views -->
    <record id="view_tursys_booking_list" model="ir.ui.view">
        <field name="name">tursys.booking.list</field>
        <field name="model">tursys.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings">
                <field name="name"/>
                <field name="excursion_id"/>
                <field name="pax_name"/>
                <field name="pax_vat"/>
                <field name="pax_age"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="view_tursys_booking_form" model="ir.ui.view">
        <field name="name">tursys.booking.form</field>
        <field name="model">tursys.booking</field>
        <field name="arch" type="xml">
            <form string="Booking Card">
                <header>
                    <button name="action_confirm" string="Confirm Booking" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="%(tursys.action_report_booking_voucher)d" string="Print Voucher" type="action" class="btn-secondary" icon="fa-ticket" invisible="state == 'cancelled'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Booking Number"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <field name="qr_uuid" invisible="not qr_uuid" class="text-muted small"/>
                    </div>
                    <group>
                        <group string="Service Details" invisible="context.get('hide_excursion')">
                            <field name="excursion_id" domain="[('state', '=', 'scheduled'), ('capacity_available', '>', 0)]"/>
                        </group>
                        <group string="Passenger Profile">
                            <field name="pax_name" placeholder="Full Name" readonly="state != 'draft'"/>
                            <field name="pax_vat" placeholder="DNI / Passport" readonly="state != 'draft'"/>
                            <field name="pax_birthdate" readonly="state != 'draft'"/>
                            <field name="pax_nationality_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="pax_language_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Contact Data">
                            <field name="pax_email" widget="email" placeholder="email@example.com" readonly="state != 'draft'"/>
                            <field name="pax_phone" widget="phone" placeholder="+54..." readonly="state != 'draft'"/>
                        </group>
                        <group string="Special Needs &amp; Notes">
                            <field name="pax_special_needs" placeholder="Medical conditions, diets..." readonly="state != 'draft'"/>
                            <field name="observations" readonly="state != 'draft'"/>
                            <field name="passenger_id" invisible="not passenger_id" class="oe_read_only"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_tursys_booking_search" model="ir.ui.view">
        <field name="name">tursys.booking.search</field>
        <field name="model">tursys.booking</field>
        <field name="arch" type="xml">
            <search string="Search Passengers">
                <field name="pax_name"/>
                <field name="pax_vat"/>
                <field name="excursion_id"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_excursion" string="Excursion" context="{'group_by': 'excursion_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_tursys_excursion" model="ir.actions.act_window">
        <field name="name">Excursions</field>
        <field name="res_model">tursys.excursion</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_tursys_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">tursys.booking</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_tursys_all_passengers" model="ir.actions.act_window">
        <field name="name">Passengers List</field>
        <field name="res_model">tursys.booking</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_confirmed': 1}</field>
    </record>

    <record id="action_tursys_nationality" model="ir.actions.act_window">
        <field name="name">Nationalities</field>
        <field name="res_model">tursys.nationality</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_tursys_language" model="ir.actions.act_window">
        <field name="name">Languages</field>
        <field name="res_model">tursys.language</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_tursys_root" name="TurSys" sequence="10"/>
    <menuitem id="menu_tursys_excursion" name="Excursions" parent="menu_tursys_root" action="action_tursys_excursion" sequence="10"/>
    <menuitem id="menu_tursys_booking" name="Bookings" parent="menu_tursys_root" action="action_tursys_booking" sequence="20"/>
    <menuitem id="menu_tursys_passengers" name="Passengers List" parent="menu_tursys_root" action="action_tursys_all_passengers" sequence="30"/>
    
    <menuitem id="menu_tursys_config" name="Configuration" parent="menu_tursys_root" sequence="100"/>
    <menuitem id="menu_tursys_nationality" name="Nationalities" parent="menu_tursys_config" action="action_tursys_nationality" sequence="10"/>
    <menuitem id="menu_tursys_language" name="Languages" parent="menu_tursys_config" action="action_tursys_language" sequence="20"/>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categoría de la app en la pantalla de grupos -->
    <record id="module_category_tursys" model="ir.module.category">
        <field name="name">TurSys</field>
        <field name="description">Tourism agency management</field>
        <field name="sequence">20</field>
    </record>

    <!-- Grupo funcional "Guía": marca al usuario como guía (sirve para cualquier tipo
         de usuario, backend o portal). NO implica Portal, por lo que un usuario de
         backend (Interno) también puede ser guía. -->
    <record id="group_tursys_guide" model="res.groups">
        <field name="name">Guide</field>
        <field name="category_id" ref="module_category_tursys"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Field guide that can be assigned as responsible or assistant guide of an excursion.</field>
    </record>

    <!-- Grupo "Guía (Portal)": guía de campo que sólo entra al portal (sin backend).
         Implica el grupo funcional Guía y el tipo de usuario Portal. -->
    <record id="group_tursys_guide_portal" model="res.groups">
        <field name="name">Guide (Portal)</field>
        <field name="category_id" ref="module_category_tursys"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_tursys_guide'), ref('base.group_portal')])]"/>
        <field name="comment">Guide who logs into the portal only (no backend access) and only sees the excursions assigned to them.</field>
    </record>

    <!-- Regla: un guía de portal sólo ve las excursiones donde es responsable o auxiliar.
         Aplica sólo al grupo Portal para NO limitar a los usuarios de backend. -->
    <record id="rule_tursys_excursion_guide" model="ir.rule">
        <field name="name">Excursion: portal guide only sees assigned excursions</field>
        <field name="model_id" ref="model_tursys_excursion"/>
        <field name="groups" eval="[(6, 0, [ref('group_tursys_guide_portal')])]"/>
        <field name="domain_force">['|', ('guide_id', '=', user.id), ('assistant_guide_ids', 'in', [user.id])]</field>
    </record>

    <!-- Regla: un guía de portal sólo ve las reservas de las excursiones que tiene asignadas. -->
    <record id="rule_tursys_booking_guide" model="ir.rule">
        <field name="name">Booking: portal guide only sees bookings of assigned excursions</field>
        <field name="model_id" ref="model_tursys_booking"/>
        <field name="groups" eval="[(6, 0, [ref('group_tursys_guide_portal')])]"/>
        <field name="domain_force">['|', ('excursion_id.guide_id', '=', user.id), ('excursion_id.assistant_guide_ids', 'in', [user.id])]</field>
    </record>
</odoo>

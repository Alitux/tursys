#. module: tursys
#: model:mail.template,body_html:tursys.email_template_booking_voucher
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Hello <t t-out=\"object.pax_name\"/>,<br/><br/>\n"
"                        Thank you for booking with <strong><t t-out=\"res_company.name\"/></strong>.\n"
"                        Please find your voucher for the excursion <strong><t t-out=\"object.excursion_id.product_id.name\"/></strong> attached to this email.\n"
"                        <br/><br/>\n"
"                        <strong>Details:</strong><br/>\n"
"                        - Date: <t t-out=\"object.excursion_id.start_datetime.strftime('%d/%m/%Y')\"/><br/>\n"
"                        - Time: <t t-out=\"object.excursion_id.start_datetime.strftime('%H:%M')\"/> hs<br/>\n"
"                        <br/>\n"
"                        We look forward to seeing you!\n"
"                        <br/><br/>\n"
"                        Best regards.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr "<div style=\"margin: 0px; padding: 0px;\">\n                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n                        Hola <t t-out=\"object.pax_name\"/>,<br/><br/>\n                        Gracias por reservar con <strong><t t-out=\"res_company.name\"/></strong>.\n                        Adjunto encontrara su voucher para la excursion <strong><t t-out=\"object.excursion_id.product_id.name\"/></strong>.\n                        <br/><br/>\n                        <strong>Detalles:</strong><br/>\n                        - Fecha: <t t-out=\"object.excursion_id.start_datetime.strftime('%d/%m/%Y')\"/><br/>\n                        - Hora: <t t-out=\"object.excursion_id.start_datetime.strftime('%H:%M')\"/> hs<br/>\n                        <br/>\n                        Lo esperamos!\n                        <br/><br/>\n                        Saludos cordiales.\n                    </p>\n                </div>"

